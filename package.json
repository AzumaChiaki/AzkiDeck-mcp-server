{
  "name": "azkideck-mcp-server",
  "version": "0.1.1",
  "description": "Multi-tenant MCP relay server for AzkiDeck phone bridges (Android/iOS)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "azkideck-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0"
}
